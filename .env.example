# --- PostgreSQL (conteneur) ---
POSTGRES_USER=transpo
POSTGRES_PASSWORD=transpo_dev
POSTGRES_DB=transpo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://transpo:transpo_dev@postgres:5432/transpo

# --- API ---
API_PORT=3000
# Secret de signature JWT — À REMPLACER en prod, ne jamais committer un vrai secret
JWT_SECRET=change-me-in-prod

# --- Divers ---
NODE_ENV=development

# --- Géocodage OpenStreetMap (Nominatim) — localisation par lien, cf. docs/adr/0002 ---
# Service public : 1 req/s max, User-Agent identifiant obligatoire. Vide = désactivé.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Portrail/1.0 (livraison du dernier kilometre; https://portrail.ma)
# Facultatif : e-mail de contact transmis à Nominatim (recommandé par sa politique d'usage)
NOMINATIM_EMAIL=
