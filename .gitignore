# --- Artefacts de recette ---------------------------------------------------
# Les VERDICTS et le rapport sont versionnés (ce sont eux qui portent le raisonnement).
# Les preuves binaires ne le sont pas : 138 vidéos pèsent 147 Mo et gonfleraient le dépôt
# définitivement. À pousser vers un stockage d'artefacts (ou Git LFS) si on veut les garder.
qa/recette/*/**/*.webm
qa/recette/*/**/*.png
qa/recette/*/**/*.mp4
qa/recette/*/videos/
qa/recette/*/artefacts/
qa/recette/*/resultats.json
apps/e2e-web/test-results/
apps/e2e-web/playwright-report/
.DS_Store
*.tsbuildinfo

# Justificatifs d'envoi push — clés privées, jamais versionnées.
# Un compte de service Firebase donne le droit d'envoyer au nom du projet : le déposer
# dans un dépôt, même privé, c'est le donner à quiconque clone.
*service-account*.json
firebase-adminsdk*.json
*.p8
*.p12

# Projets natifs régénérés par `expo prebuild` (génération native continue).
# Les versionner ferait diverger deux sources de vérité : app.json et le code généré.
apps/driver-app/android/
apps/driver-app/ios/

# Vidéos de démo : rendus et voix synthétisées (régénérables par qa/demo/).
qa/demo/sortie/
# Vidéos de démo publiées dans la console (produites par qa/demo/, poussées par qa/demo/publier.mjs).
apps/console-web/demos/
# Aperçus temporaires partagés par lien (copiés à la main dans les pods, jamais versionnés).
apps/site-vitrine/apercu/
# Rendus de la vidéo promotionnelle (images, voix, musique et vidéo finale) : régénérables, non versionnés.
qa/promo/medias/
qa/promo/sortie/
qa/recette/sortie/
